<Project Sdk="Microsoft.NET.Sdk">
  <!-- MCP server for Robot Structural Analysis 2027. Override the install folder with -p:RobotPath="..." -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>civilsenior-robot</AssemblyName>
    <RootNamespace>CivilSenior.Mcp.Robot</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RobotPath Condition="'$(RobotPath)' == '' And Exists('C:\Program Files\Autodesk\Robot Structural Analysis Professional 2027\Exe\Interop.RobotOM.dll')">C:\Program Files\Autodesk\Robot Structural Analysis Professional 2027</RobotPath>
    <RobotPath Condition="'$(RobotPath)' == ''">D:\Autodesk\Robot Structural Analysis Professional 2027</RobotPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <Reference Include="Interop.RobotOM" HintPath="$(RobotPath)\Exe\Interop.RobotOM.dll" EmbedInteropTypes="true" />
  </ItemGroup>
</Project>
